{
  "name": "belhotel-site",
  "version": "1.0.0",
  "description": "Site vitrine du complexe Belhotel avec hôtel, restaurant et bar",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "test": "jest",
    "test:coverage": "jest --coverage"
  },
  "dependencies": {
    "express": "^4.18.2"
  },
  "devDependencies": {
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  },
  "jest": {
    "testEnvironment": "node",
    "collectCoverageFrom": [
      "server.js"
    ],
    "coveragePathIgnorePatterns": [
      "/node_modules/",
      "/src/"
    ]
  }
}
